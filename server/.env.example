# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recovera?schema=public"

# AUTHENTICATION
JWT_SECRET=recovera_super_secret_jwt_key_prod_2026
JWT_EXPIRES_IN=7d

# TWILIO (SMS & Voice Calls)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_NUMBER_1=
TWILIO_TEST_NUMBER_2=
TWILIO_TEST_NUMBER_3=+15552345678
TWILIO_PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
TWILIO_SMS_ENABLED=true

# ELEVENLABS (Natural Voice Synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# WEB PUSH (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
