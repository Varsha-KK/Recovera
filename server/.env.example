# ============================================================
# RECOVERA — Intelligent Post-Discharge Care Platform
# Environment Variables Template
# ============================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recovera?schema=public"

# AUTHENTICATION
JWT_SECRET=recovera_super_secret_jwt_key_prod_2026
JWT_EXPIRES_IN=7d
DEV_ADMIN_PASSWORD=RecoveraAdmin2026!

# EXOTEL (SMS & Outbound Voice Calls)
# Account configuration
EXOTEL_ACCOUNT_SID=recovera1
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VOICE_APP_ID=1338862

# API Credentials (Enter your actual API Key and Token from Exotel dashboard)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Exotel SMS Configuration (Approved Sender ID / Header or ExoPhone)
EXOTEL_SMS_SENDER_ID=

# Exotel Voice Configuration (Registered Virtual Number / ExoPhone for Caller ID)
EXOTEL_VOICE_EXOPHONE=

# Optional India DLT Parameters (for TRAI compliance)
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=

# ELEVENLABS (Natural Voice Synthesis for Audio Previews)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# WEB PUSH (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@recovera.health

# FEATURE FLAGS
SMS_ENABLED=true
VOICE_CALL_ENABLED=true
WEB_PUSH_ENABLED=true
