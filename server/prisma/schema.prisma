generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  phone          String?
  role           Role            @default(PATIENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patientProfile PatientProfile?

  @@map("users")
}

model Hospital {
  id         String           @id @default(uuid())
  hospitalId String           @unique
  name       String
  address    String?
  city       String?
  state      String?
  phone      String?
  email      String?
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  carePlans  CarePlan[]
  patients   PatientProfile[]

  @@map("hospitals")
}

model Disease {
  id                        String     @id @default(uuid())
  code                      String     @unique
  name                      String
  description               String?
  defaultFollowUpWindowDays Int        @default(14)
  baselineSeverity          String     @default("MEDIUM")
  preConsultationTests      Json?
  guidelines                String?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  carePlans                 CarePlan[]

  @@map("diseases")
}

model PatientProfile {
  id                  String               @id @default(uuid())
  patientId           String               @unique
  userId              String?              @unique
  hospitalId          String?
  name                String
  age                 Int
  gender              String
  phone               String
  email               String?
  diagnosis           String
  primaryDoctor       String
  department          String
  dischargeDate       DateTime
  baselineSeverity    String               @default("MEDIUM")
  riskScore           Int                  @default(20)
  riskLevel           String               @default("LOW")
  reminderPreferences Json?
  status              String               @default("ACTIVE")
  notes               String?
  vitals              Json?
  medications         Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointments        Appointment[]
  callLogs            CallLog[]
  carePlans           CarePlan[]
  communicationLogs   CommunicationLog[]
  medicationReminders MedicationReminder[]
  notifications       Notification[]
  hospital            Hospital?            @relation(fields: [hospitalId], references: [hospitalId])
  user                User?                @relation(fields: [userId], references: [id])
  reminderJobs        ReminderJob[]
  riskAssessments     RiskAssessment[]
  testRequirements    TestRequirement[]

  @@map("patient_profiles")
}

model CarePlan {
  id                     String            @id @default(uuid())
  carePlanId             String            @unique
  patientId              String
  hospitalId             String?
  diseaseId              String?
  diseaseName            String
  severity               String
  dischargeDate          DateTime
  recommendedWindowStart DateTime
  recommendedWindowEnd   DateTime
  isActive               Boolean           @default(true)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  disease                Disease?          @relation(fields: [diseaseId], references: [code])
  hospital               Hospital?         @relation(fields: [hospitalId], references: [hospitalId])
  patient                PatientProfile    @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  followUps              FollowUp[]
  testRequirements       TestRequirement[]

  @@map("care_plans")
}

model FollowUp {
  id          String    @id @default(uuid())
  milestoneId String    @unique
  carePlanId  String
  type        String
  title       String
  description String?
  dueDate     DateTime
  status      String    @default("PENDING")
  completedAt DateTime?
  channels    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  carePlan    CarePlan  @relation(fields: [carePlanId], references: [carePlanId], onDelete: Cascade)

  @@map("follow_ups")
}

model Appointment {
  id                 String               @id @default(uuid())
  appointmentId      String               @unique
  patientId          String
  hospital           String
  department         String
  doctorName         String
  type               String
  scheduledDate      DateTime
  scheduledTime      String
  windowStart        DateTime?
  windowEnd          DateTime?
  status             String               @default("SCHEDULED")
  isOverdue          Boolean              @default(false)
  confirmedAt        DateTime?
  cancellationReason String?
  patientNotes       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  history            AppointmentHistory[]
  patient            PatientProfile       @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  callLogs           CallLog[]
  communicationLogs  CommunicationLog[]
  reminderJobs       ReminderJob[]

  @@map("appointments")
}

model AppointmentHistory {
  id              String      @id @default(uuid())
  appointmentId   String
  action          String
  reason          String?
  performedBy     String
  performedByRole String
  timestamp       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)

  @@map("appointment_histories")
}

model ReminderJob {
  id            String         @id @default(uuid())
  jobId         String         @unique
  appointmentId String
  patientId     String
  channel       String
  scheduledFor  DateTime
  status        String         @default("PENDING")
  payload       Json?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointment   Appointment    @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)
  patient       PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("reminder_jobs")
}

model RiskAssessment {
  id                String         @id @default(uuid())
  assessmentId      String         @unique
  patientId         String
  calculatedScore   Int
  riskLevel         String
  factors           Json
  summary           String?
  recommendedAction String?
  timestamp         DateTime       @default(now())
  createdAt         DateTime       @default(now())
  patient           PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("risk_assessments")
}

model Notification {
  id             String         @id @default(uuid())
  notificationId String         @unique
  patientId      String
  title          String
  message        String
  type           String         @default("APPOINTMENT_REMINDER")
  isRead         Boolean        @default(false)
  link           String?
  createdAt      DateTime       @default(now())
  patient        PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("notifications")
}

model CommunicationLog {
  id                String         @id @default(uuid())
  logId             String         @unique
  patientId         String
  appointmentId     String?
  channel           String
  recipient         String
  message           String
  status            String
  providerMessageId String?
  metadata          Json?
  timestamp         DateTime       @default(now())
  createdAt         DateTime       @default(now())
  appointment       Appointment?   @relation(fields: [appointmentId], references: [appointmentId])
  patient           PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("communication_logs")
}

model CallLog {
  id              String         @id @default(uuid())
  callId          String         @unique
  patientId       String
  appointmentId   String?
  phone           String
  patientName     String
  purpose         String
  callSid         String?
  status          String         @default("QUEUED")
  durationSeconds Int            @default(0)
  transcription   String?
  audioUrl        String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime       @default(now())
  appointment     Appointment?   @relation(fields: [appointmentId], references: [appointmentId])
  patient         PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("call_logs")
}

model MedicationReminder {
  id             String         @id @default(uuid())
  patientId      String
  medicationName String
  dosage         String
  frequency      String
  times          Json?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  patient        PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("medication_reminders")
}

model TestRequirement {
  id          String         @id @default(uuid())
  patientId   String
  carePlanId  String?
  testName    String
  description String?
  dueDate     DateTime
  status      String         @default("PENDING")
  completedAt DateTime?
  results     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  carePlan    CarePlan?      @relation(fields: [carePlanId], references: [carePlanId])
  patient     PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("test_requirements")
}

enum Role {
  ADMIN
  PATIENT
  COORDINATOR
}
